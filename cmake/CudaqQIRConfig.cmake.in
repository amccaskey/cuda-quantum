@PACKAGE_INIT@

# Provide the include and lib directories.
set_and_check(CUDAQIR_INCLUDE_DIR "@CMAKE_INSTALL_PREFIX@/include")
set_and_check(CUDAQIR_LIB_DIR     "@CMAKE_INSTALL_PREFIX@/lib")

# Pull in the exported CMake targets (QIRDialect, QIRToLLVM).
include("${CMAKE_CURRENT_LIST_DIR}/CudaqQIRTargets.cmake")

# Convenience aliases.
if(NOT TARGET CudaqQIR::QIRDialect AND TARGET QIRDialect)
  add_library(CudaqQIR::QIRDialect ALIAS QIRDialect)
endif()
if(NOT TARGET CudaqQIR::QIRToLLVM AND TARGET QIRToLLVM)
  add_library(CudaqQIR::QIRToLLVM ALIAS QIRToLLVM)
endif()

check_required_components(CudaqQIR)
